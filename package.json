{
  "name": "@sasjs/utils",
  "description": "Utilities and types for SASjs",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json"
          ]
        }
      ],
      "@semantic-release/github"
    ]
  },
  "typings": "./index.d.ts",
  "files": [
    "index.js",
    "index.js.map",
    "*.d.ts",
    "auth/**",
    "compileTree/**",
    "conversion/**",
    "error/**",
    "file/**",
    "formatter/**",
    "fs/**",
    "input/**",
    "logger/**",
    "macros/**",
    "sasjsCli/**",
    "time/**",
    "types/**",
    "utils/**",
    "README.md"
  ],
  "scripts": {
    "nodeVersionMessage": "echo \u001b[33m make sure you are running node lts version \u001b[0m",
    "build": "npm run nodeVersionMessage && npx rimraf build && tsc && npm run copy:macros",
    "copy:macros": "ts-node ./scripts/copySASjsCore.ts",
    "publishInit": "cp -r ./build/* . && rm -rf ./build && rm -rf ./src && rm jest.config.js && rm tsconfig.json",
    "package:lib": "npm run build && cp ./package.json build && cp README.md build && cd build && npm version \"5.0.0\" && npm pack",
    "test": "jest --config=jest.config.js --coverage",
    "lint:fix": "npx prettier --write \"{src,test}/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\"",
    "lint": "npx prettier --check \"{src,test}/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\"",
    "setup": "git config core.hooksPath ./.git-hooks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasjs/utils.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sasjs/utils/issues"
  },
  "homepage": "https://github.com/sasjs/utils#readme",
  "devDependencies": {
    "@sasjs/core": "5.3.0",
    "@types/jest": "29.4.0",
    "babel-jest": "29.4.3",
    "jest": "29.4.3",
    "jest-extended": "3.2.4",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "4.5.4",
    "@nogoo9/gitleaks": "8.30.1-post.2"
  },
  "dependencies": {
    "@fast-csv/format": "5.0.7",
    "@types/fs-extra": "11.0.4",
    "@types/prompts": "2.4.9",
    "chalk": "4.1.1",
    "consola": "3.4.2",
    "fs-extra": "11.4.1",
    "jwt-decode": "4.0.0",
    "prompts": "2.4.2"
  },
  "version": "3.7.2"
}
